@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Libreria USAC</h1>
</div>

<div class="hero">
    <h1>Bienvenido al Sistema de Gestión de Libros</h1>
    <p>Selecciona una opción del menú para comenzar a administrar tu catálogo.</p>
</div>

<div class="menu-grid">
    <a asp-page="/Cargar" class="menu-card">
        <h3>Cargar Datos XML</h3>
    </a>

    <a asp-page="/Catalogo" class="menu-card">
        <h3>Ver Catálogo</h3>
    </a>

    <a asp-page="Panel" class="menu-card">
        <h3>Panel de Libros</h3>
    </a>

    <a asp-page="/Ayuda" class="menu-card">
        <h3>Ayuda</h3>
    </a>
</div>

